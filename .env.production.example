# PartyGameSDK v0.4.0 — Production Environment Variables
#
# Copy to .env.production and fill in values:
#   cp .env.production.example .env.production
#
# ⚠️  WARNING: Never commit .env.production to git!

# === REQUIRED ===
NODE_ENV=production
ADMIN_TOKEN=REPLACE_WITH_32_CHAR_RANDOM_STRING
STORE_TYPE=redis
REDIS_URL=redis://redis:6379
SERVER_HOST=your-domain.example.com
# === RECOMMENDED ===
LOG_FORMAT=json
LOG_LEVEL=info
LOG_PREFIX=partygame-prod
PORT=3000
# === TLS ===
# TLS_CERT_PATH=/etc/letsencrypt/live/your-domain/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/your-domain/privkey.pem
