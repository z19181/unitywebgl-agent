# RAG Memory Environment Variables
# Copy to .env and fill in real values (never commit .env)

# OpenAI API Key (get from https://platform.openai.com/api-keys/)
# DO NOT put real API key in this file - use .env only
OPENAI_API_KEY=

# Embedding model (default: text-embedding-3-small)
RAG_EMBEDDING_MODEL=text-embedding-3-small

# Vector dimensions (1536 for text-embedding-3-small)
RAG_VECTOR_DIMENSIONS=1536

# PostgreSQL connection string
# Format: postgres://user:password@host:port/database
# DO NOT commit real password - use .env only
RAG_DATABASE_URL=postgres://localhost:5432/rag_memory

# Retrieval mode: keyword | embedding | hybrid
RAG_RETRIEVAL_MODE=hybrid

# Optional: OpenAI API base URL (for proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Embedding batch size (default: 100)
# RAG_EMBEDDING_BATCH_SIZE=100

# Optional: Query timeout in milliseconds (default: 5000)
# RAG_QUERY_TIMEOUT_MS=5000
