# Agent Dashboard — Environment Variables (v1.1.3)
# Copy to .env.local and edit as needed.

# ── Metrics Source ─────────────────────────────────────
# 'mock'     → always use mock data (default, works without Docker)
# 'prometheus' → fetch real metrics from Prometheus (requires Docker + monitoring stack)
NEXT_PUBLIC_METRICS_MODE=mock

# ── Prometheus ────────────────────────────────────────
# Prometheus URL (default: http://localhost:9090)
# Only used when NEXT_PUBLIC_METRICS_MODE=prometheus
NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090

# ── Build-time (Next.js) ───────────────────────────
# Non-NEXT_PUBLIC_ vars are only available at build time.
# Add any server-side secrets below as needed.
